# SCAS Floci emulator — copy to .env (floci-setup.sh does this automatically)
FLOCI_PORT=4566
FLOCI_DEFAULT_REGION=us-east-1
FLOCI_STORAGE_MODE=memory
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Set to 1 after setup when using --image (published container, no source build)
FLOCI_USE_IMAGE=0

# Published image tag when FLOCI_USE_IMAGE=1
FLOCI_IMAGE=floci/floci:latest-compat

# Host docker.sock group id (floci-up.sh / floci-setup.sh overwrite this)
DOCKER_GID=0

# true = run Floci as root so /_floci/ui can spawn the floci-ui sidecar when the
# socket is root-owned. Set false only if group_add + docker group is enough.
FLOCI_RUN_AS_ROOT=true
