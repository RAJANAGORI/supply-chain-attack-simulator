      "title": "Mutable tag",
      "items": [
        "build.yml uses vendor/build-action@v1, not a commit SHA",
        "run-ci.sh maps that tag onto malicious-action/ locally",
        "The action returns before POST unless TESTBENCH_MODE is enabled"
      ]
    },
