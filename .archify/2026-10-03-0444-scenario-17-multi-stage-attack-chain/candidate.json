    {
      "dot": "rose",
      "title": "Three stages",
      "items": [
        "victim-app requires stage1-access-lib and stage2-compromised-lib",
        "Stage 1 writes .stolen/token.json, then POSTs stage1 to 127.0.0.1:3017/collect",
        "Stage 2 reads that token and POSTs stage2; the same file then POSTs stage3"
      ]
    },
    {
      "dot": "emerald",
      "title": "One collector",
      "items": [
