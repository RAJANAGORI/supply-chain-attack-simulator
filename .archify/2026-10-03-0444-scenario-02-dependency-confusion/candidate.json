    {
      "dot": "rose",
      "title": "Version race",
      "items": [
        "Internal @techcorp/auth-lib is version 1.2.3 and marked private",
        "The attacker package is the same name at version 999.999.999",
        "corporate-app/.npmrc sends the @techcorp scope to localhost:4874"
      ]
    },
    {
      "dot": "emerald",
      "title": "Then the postinstall",
      "items": [
        "npm takes the higher version from that registry",
        "postinstall POSTs to localhost:3000/collect only if TESTBENCH_MODE is enabled",
        "The mock appends captured-data.json"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional sink",
      "items": [
