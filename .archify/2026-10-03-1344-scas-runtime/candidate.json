  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Payloads return before any POST unless TESTBENCH_MODE is enabled",
        "The canonical payload posts to localhost:3000/collect. Floci upload runs only if SCAS_FLOCI_ENABLED=1",
        "The Node mock listens on port 3000 and does not pass a bind host"
      ]
    },
    {
      "dot": "emerald",
      "title": "Same contract, other labs",
      "items": [
        "Scenario 01 is the canonical collector. Other labs keep the same gate and forward hook",
        "06 uses three localhost collectors. 22 uses a Python server bound to 127.0.0.1:3022",
        "02 and 11 add a localhost registry. Ports and POST paths differ by lab"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional, not on this path",
      "items": [
        "forwardCaptureIfEnabled returns null when SCAS_ES_URL is unset",
        "The dashboard script defaults Elasticsearch to 127.0.0.1:9200 and Kibana to 127.0.0.1:5601",
        "start-dashboard.sh binds 0.0.0.0:3100 by default and probes 127.0.0.1:3100"
      ]
    }
  ]
