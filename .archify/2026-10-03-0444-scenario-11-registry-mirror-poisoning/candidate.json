  "cards": [
    {
      "dot": "rose",
      "title": "Mirror",
      "items": [
        "corporate-app/.npmrc sets registry to the EnterpriseCorp mirror host on port 4873",
        "registry-server.js binds 127.0.0.1:4873 and serves the lab tarballs",
        "enterprise-utils postinstall returns unless TESTBENCH_MODE is enabled"
      ]
    },
    {
      "dot": "emerald",
      "title": "Collector",
      "items": [
        "POST /collect goes to localhost:3000",
        "secure-lib/postinstall.js posts to the same collector"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional sink",
      "items": [
        "forwardCaptureIfEnabled returns null when SCAS_ES_URL is unset"
      ]
    }
