  "cards": [
    {
      "dot": "rose",
      "title": "Two bad releases",
      "items": [
        "v1.82.6 is a clean package with no import hook",
        "run_victim.py imports v1.82.7, which POSTs on import",
        "v1.82.8 is a .pth hook that POSTs at interpreter startup"
      ]
    },
    {
      "dot": "emerald",
      "title": "Collector",
      "items": [
        "Both paths POST to 127.0.0.1:3022/collect only if TESTBENCH_MODE is enabled",
        "The Python server binds 127.0.0.1 and stores events[]"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional sink",
      "items": [
        "The collector returns immediately when SCAS_ES_URL is unset",
        "TESTBENCH_OFFLINE=1 skips both the import path and the .pth path"
      ]
    }
